# ============================================================================
#  LegacyFolia — server.config
# ============================================================================
#
#  The one file you are meant to edit. Settings are grouped by what they do,
#  not by which server this fork inherited them from.
#
#  This file does not replace bukkit.yml, spigot.yml or config/paper-global.yml.
#  Those are still generated, still read, and still what plugins see. What this
#  file does is override them at start-up: a key set here wins, a key left out
#  leaves the original file's value alone.
#
#  Every setting is commented. When you upgrade, new settings appear here with
#  their comments and your own edits are left untouched.
#
#  Documentation: https://github.com/adrielorihuela/LegacyFolia
# ============================================================================


# ----------------------------------------------------------------------------
#  Dimensions — which worlds the server creates at all
# ----------------------------------------------------------------------------
#  Turning a dimension off means it is never created: no world folder, no
#  chunks in memory, no entities ticking, no region threads spent on it. On a
#  lobby or a minigame server that never uses the Nether or the End, this is
#  the cheapest performance setting there is.
#
#  Turning one off later does not delete a world folder that already exists;
#  it just stops loading it. Turning it back on picks up where it left off.
[dimensions]

# The main world. Cannot be turned off — the server has nowhere to put players
# without it, so setting this to false is refused and logged at start-up.
overworld = true

# The Nether, stored in world/dimensions/minecraft/the_nether.
# Off means nether portals do nothing when entered.
nether = true

# The End, stored in world/dimensions/minecraft/the_end.
# Off means end portals do nothing when entered, and the ender dragon fight
# never exists.
end = true


# ----------------------------------------------------------------------------
#  Network — how players reach this server
# ----------------------------------------------------------------------------
[network.velocity]

# The file holding the Velocity modern-forwarding secret, relative to config/
# unless an absolute path is given.
#
# The secret lives in its own file rather than inline, because configuration
# files get pasted into issues and support channels and photographed in
# screenshots, and anything on the line below whatever was being asked about
# goes with them. This is the same file name Velocity uses on the proxy side,
# so you can copy the proxy's file across unchanged.
#
# The file is created empty on first start. Put the secret in it, on one line,
# with nothing else. If you are upgrading and already had the secret in
# config/paper-global.yml, it is moved here for you and the old key is blanked.
#
# The PAPER_VELOCITY_SECRET environment variable still overrides this, for
# containers that would rather not mount a file.
secret-file = "forwarding.secret"


# ----------------------------------------------------------------------------
#  Server — start-up and console
# ----------------------------------------------------------------------------
[server]

# How long to wait at the EULA prompt, in seconds. 0 waits forever.
#
# On first start, if you have not agreed to the Minecraft EULA, the server
# asks at the console instead of stopping and telling you to go edit a file.
# Press ENTER to agree, ESC to stop. Nothing is ever agreed to on your behalf:
# only ENTER accepts, and letting this time out does not.
#
# A server with no console attached - started by systemd, in a container, or
# with --noconsole - is never asked, because there would be nobody there to
# answer and the prompt would look like a hang. It stops with the usual
# message instead, and you set eula=true in eula.txt yourself.
eula-prompt-timeout-seconds = 120


# ----------------------------------------------------------------------------
#  Plugins
# ----------------------------------------------------------------------------
[plugins.auto-update]

# Keep the plugins listed below up to date, checked once at every start-up,
# before they are loaded.
#
# Whether a plugin is current is decided by the checksum its source publishes,
# not by the file name, and the same checksum verifies the download, so a
# truncated file is never put in place. Older jars of the same plugin are
# removed, because two jars claiming one plugin id make the loader refuse
# whichever it happens to read second.
#
# If a source cannot be reached and the jar is already there, the server warns
# and carries on with what it has. If the jar is NOT there, the server stops:
# starting without a plugin you listed on purpose is not safe, since it may be
# the one granting permissions.
enabled = false

# Plugins from hangar.papermc.io, by project slug.
# The newest Paper build for this Minecraft version is used; if there is none,
# the plugin's newest build is used instead and the server says so. Channels
# are tried Release, then Beta, Alpha and Snapshot, because some plugins go
# months publishing only betas.
hangar = []

# Plugins from modrinth.com, by project slug -- the name in its page's address,
# not its display name. Both the paper and folia loaders are accepted.
modrinth = []

# Plugins from GitHub releases, as "owner/repo". The owner cannot be left out.
#
# Add ":regex" when a release attaches several jars and you need to pick one,
# for example "ViaVersion/ViaRewind:Bukkit". Sources and javadoc jars are
# always ignored.
#
# Releases are walked newest first and pre-releases are accepted, because many
# projects ship betas for months between stable tags. Drafts are skipped.
github = []

# LuckPerms, from its own metadata service. A switch rather than a list, since
# there is only one of it.
#
# Note that LuckPerms publishes no checksum in any format, so this is the one
# plugin whose freshness is judged by its file name, which carries the build
# number. The server says so in the log rather than letting it look verified.
luckperms = false

# A file holding a GitHub token, relative to config/ unless absolute.
#
# Entirely optional: without one, GitHub allows sixty requests an hour per
# address, which is plenty unless the server restarts constantly. With one it
# is five thousand. A token is also what lets this reach a private repository.
#
# The file is created empty on first start. Put the token in it on one line.
# The GITHUB_TOKEN environment variable overrides it.
github-token-file = "github.token"


# ----------------------------------------------------------------------------
#  Chunks
# ----------------------------------------------------------------------------
[chunks.adaptive-view-distance]

# Give each player only as many chunks as they are actually using.
#
# A server's view distance has to be set for whoever wants the most, so
# everybody else is sent and ticked chunks they never look at. Two kinds of
# waste come out of that: chunks past what a client asked for, which it throws
# away the moment they arrive, and chunks belonging to somebody who is not at
# the keyboard at all. Both are handed back.
#
# A client asking for 8 gets 8 no matter how high view-distance is set, and a
# player who has gone away is dropped by the reductions below until they come
# back. Nothing here raises anyone above the server's view distance unless they
# have the permission legacyfolia.chunkscope.unlimited.
enabled = false

# Chunks to take off a player who is not playing. The simulation distance is
# always capped to the view distance, whatever these say: ticking chunks nobody
# can see is exactly the waste being removed.
view-reduction = 4
simulation-reduction = 4

# The floor and ceiling for both distances. Minecraft's own limits are 2 and 32
# and anything outside them is clamped rather than refused.
min-distance = 3
max-distance = 32

# How long without a deliberate action counts as away. Breaking or placing a
# block, using an item, clicking in a container, attacking or typing all reset
# this outright.
afk-seconds = 300

# How often each player is re-examined. This is per player, counted from their
# own tick, so the work is spread out rather than done for everybody at once.
check-seconds = 10

# Whether to see through the usual ways of looking busy while away.
#
# A timer on its own is not enough, because defeating one is the whole point of
# an anti-AFK macro. With these on, movement is only believed when a person
# could have produced it: walking a circuit of a few blocks, turning at a
# perfectly even rate, or clicking with no jitter between swings are all treated
# as being away rather than as playing.
detect-anti-afk-macros = true
detect-auto-clickers = true

# Log every change, with the reason. Useful when tuning the numbers above.
debug = false


# ----------------------------------------------------------------------------
#  Combat — the 1.8 mechanics
# ----------------------------------------------------------------------------
#  Every default below is the value 1.8.8 actually used, read from that
#  version's own source rather than from memory. Turn this on and change
#  nothing and you get the combat that version had.
#
#  Each mechanic is switchable on its own, because a server may want the old
#  knockback without the old attack speed, or the other way round.
[combat]

# Whether any of this applies. On by default.
enabled = true

# Every hit does full damage, with no charge-up between swings.
#
# This is the single biggest difference. Since 1.9 a hit is scaled by how long
# you waited, and the client draws a charge indicator to match. Turning this on
# removes all of that: swing as fast as you can click, as it was.
no-attack-cooldown = true

# Remove the sweeping arc that hits everything around the target.
no-sweep-attack = true

# Use 1.8's knockback formula.
#
# The difference that matters: modern knockback only pushes a target upward if
# they are standing on the ground, so hitting somebody already in the air does
# not lift them. In 1.8 it lifted them every time, which is what lets a combo
# hold somebody off the ground.
legacy-knockback = true

# The knockback strengths. 0.4 across the board in 1.8. The vertical limit caps
# how far upward a hit can throw somebody however fast they were already rising.
knockback-horizontal = 0.4
knockback-vertical = 0.4
knockback-vertical-limit = 0.4

# Sprinting adds a level of knockback and then cancels your own sprint, and
# your horizontal speed is cut to 0.6 of what it was. This is what makes
# w-tapping work.
sprint-knockback = true
sprint-knockback-strength = 0.5

# Critical hits: falling, not on the ground, not on a ladder, not in water, not
# blinded and not riding anything, for 1.5x damage.
legacy-criticals = true
critical-multiplier = 1.5

# How long after a hit another cannot land, in ticks.
invulnerability-ticks = 20

# Let a stronger hit through during those ticks, for the difference in damage
# only. Without this, tapping somebody for half a heart makes them briefly
# immune to an axe, which is not how 1.8 played.
damage-overriding = true

# Right-clicking with a sword blocks, halving incoming damage.
#
# Note that this is a reimplementation rather than a restoration: swords have
# no blocking animation left in modern versions, so the state is kept on the
# server and signalled to the client. Players connecting through ViaVersion
# from a 1.8 client see the blocking animation; modern clients get the damage
# reduction without it.
sword-blocking = true
sword-blocking-reduction = 0.5

# Shields and the off-hand slot did not exist in 1.8.
disable-shields = true
disable-offhand = true
