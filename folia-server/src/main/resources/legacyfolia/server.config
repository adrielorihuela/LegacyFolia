# ============================================================================
#  LegacyFolia — server.config
# ============================================================================
#
#  The one file you are meant to edit. Settings are grouped by what they do,
#  not by which server this fork inherited them from.
#
#  This file does not replace bukkit.yml, spigot.yml or config/paper-global.yml.
#  Those are still generated, still read, and still what plugins see. What this
#  file does is override them at start-up: a key set here wins, a key left out
#  leaves the original file's value alone.
#
#  Every setting is commented. When you upgrade, new settings appear here with
#  their comments and your own edits are left untouched.
#
#  Documentation: https://github.com/adrielorihuela/LegacyFolia
# ============================================================================


# ----------------------------------------------------------------------------
#  Dimensions — which worlds the server creates at all
# ----------------------------------------------------------------------------
#  Turning a dimension off means it is never created: no world folder, no
#  chunks in memory, no entities ticking, no region threads spent on it. On a
#  lobby or a minigame server that never uses the Nether or the End, this is
#  the cheapest performance setting there is.
#
#  Turning one off later does not delete a world folder that already exists;
#  it just stops loading it. Turning it back on picks up where it left off.
[dimensions]

# The main world. Cannot be turned off — the server has nowhere to put players
# without it, so setting this to false is refused and logged at start-up.
overworld = true

# The Nether, stored in world/dimensions/minecraft/the_nether.
# Off means nether portals do nothing when entered.
nether = true

# The End, stored in world/dimensions/minecraft/the_end.
# Off means end portals do nothing when entered, and the ender dragon fight
# never exists.
end = true


# ----------------------------------------------------------------------------
#  Network — how players reach this server
# ----------------------------------------------------------------------------
[network.velocity]

# The file holding the Velocity modern-forwarding secret, relative to config/
# unless an absolute path is given.
#
# The secret lives in its own file rather than inline, because configuration
# files get pasted into issues and support channels and photographed in
# screenshots, and anything on the line below whatever was being asked about
# goes with them. This is the same file name Velocity uses on the proxy side,
# so you can copy the proxy's file across unchanged.
#
# The file is created empty on first start. Put the secret in it, on one line,
# with nothing else. If you are upgrading and already had the secret in
# config/paper-global.yml, it is moved here for you and the old key is blanked.
#
# The PAPER_VELOCITY_SECRET environment variable still overrides this, for
# containers that would rather not mount a file.
secret-file = "forwarding.secret"


# ----------------------------------------------------------------------------
#  Server — start-up and console
# ----------------------------------------------------------------------------
[server]

# How long to wait at the EULA prompt, in seconds. 0 waits forever.
#
# On first start, if you have not agreed to the Minecraft EULA, the server
# asks at the console instead of stopping and telling you to go edit a file.
# Press ENTER to agree, ESC to stop. Nothing is ever agreed to on your behalf:
# only ENTER accepts, and letting this time out does not.
#
# A server with no console attached - started by systemd, in a container, or
# with --noconsole - is never asked, because there would be nobody there to
# answer and the prompt would look like a hang. It stops with the usual
# message instead, and you set eula=true in eula.txt yourself.
eula-prompt-timeout-seconds = 120
