From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AdrielOrihuela <adriel.orihuela.m@gmail.com>
Date: Sat, 22 Aug 2026 18:54:02 -0500
Subject: [PATCH] Take the Velocity forwarding secret from
 config/forwarding.secret

Resolved before the enabled check so the file exists to be filled in on a
server that has not set a proxy up yet. PAPER_VELOCITY_SECRET still wins,
for containers that would rather not mount a file, and a secret left in
paper-global.yml is moved into the file and blanked there.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>

diff --git a/src/main/java/com/destroystokyo/paper/proxy/VelocityProxy.java b/src/main/java/com/destroystokyo/paper/proxy/VelocityProxy.java
index fcd94bb0b7d2c00fb225835950ff76818dfd0cca..1a079e77eda74f692489a027af3ea0c44961be7b 100644
--- a/src/main/java/com/destroystokyo/paper/proxy/VelocityProxy.java
+++ b/src/main/java/com/destroystokyo/paper/proxy/VelocityProxy.java
@@ -46,7 +46,7 @@ public class VelocityProxy {
 
         try {
             final Mac mac = Mac.getInstance("HmacSHA256");
-            mac.init(new SecretKeySpec(GlobalConfiguration.get().proxies.velocity.secret.getBytes(java.nio.charset.StandardCharsets.UTF_8), "HmacSHA256"));
+            mac.init(new SecretKeySpec(io.github.adrielorihuela.legacyfolia.network.ForwardingSecret.get().getBytes(java.nio.charset.StandardCharsets.UTF_8), "HmacSHA256")); // LegacyFolia - from config/forwarding.secret
             final byte[] mySignature = mac.doFinal(data);
             if (!MessageDigest.isEqual(signature, mySignature)) {
                 return false;
diff --git a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
index c52d41fd078b7f7aeb3633a9c196bbaba299af0f..61aac24b959ff8f351ec8744e1f5c9098cab40a0 100644
--- a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
+++ b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
@@ -122,17 +122,20 @@ public class GlobalConfiguration extends ConfigurationPart {
 
             @PostProcess
             private void postProcess() {
-                if (!this.enabled) return;
-
-                final String environmentSourcedVelocitySecret = System.getenv("PAPER_VELOCITY_SECRET");
-                if (environmentSourcedVelocitySecret != null && !environmentSourcedVelocitySecret.isEmpty()) {
-                    this.secret = environmentSourcedVelocitySecret;
+                // LegacyFolia start - keep the forwarding secret in config/forwarding.secret
+                // Done before the enabled check so the file exists to be filled in on a server that
+                // has not set a proxy up yet. The environment variable is still honoured inside.
+                if (io.github.adrielorihuela.legacyfolia.network.ForwardingSecret.resolve(this.secret)) {
+                    this.secret = ""; // migrated into the file; blanked so it is not in two places
                 }
 
-                if (this.secret.isEmpty()) {
-                    LOGGER.error("Velocity is enabled, but no secret key was specified. A secret key is required. Disabling velocity...");
+                if (!this.enabled) return;
+
+                if (io.github.adrielorihuela.legacyfolia.network.ForwardingSecret.get().isEmpty()) {
+                    LOGGER.error("Velocity is enabled, but no secret key was specified. Put it in config/forwarding.secret. Disabling velocity...");
                     this.enabled = false;
                 }
+                // LegacyFolia end - keep the forwarding secret in config/forwarding.secret
             }
         }
         public boolean proxyProtocol = false;
