From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AdrielOrihuela <adriel.orihuela.m@gmail.com>
Date: Sat, 22 Aug 2026 18:31:52 -0500
Subject: [PATCH] Answer the dimension accessors from the unified configuration

getAllowNether and getAllowEnd are what PaperWorldLoader already consults
to decide whether to create a world, and what plugins ask to find out
whether it is there. Answering both from one place is what lets a single
[dimensions] section replace two settings in two files without letting
the API disagree with which worlds actually exist.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>

diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 3fac32b420ce4ae74166eac43d38c51c1fd513cf..c5ea243b2fa3e677c088993b12b506301fea2e9e 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -783,12 +783,14 @@ public final class CraftServer implements Server {
 
     @Override
     public boolean getAllowEnd() {
-        return this.configuration.getBoolean("settings.allow-end");
+        // LegacyFolia - answered from the unified configuration, falling back to bukkit.yml
+        return io.github.adrielorihuela.legacyfolia.world.Dimensions.endEnabled(this.configuration.getBoolean("settings.allow-end"));
     }
 
     @Override
     public boolean getAllowNether() {
-        return GlobalConfiguration.get().misc.enableNether;
+        // LegacyFolia - answered from the unified configuration, falling back to paper-global.yml
+        return io.github.adrielorihuela.legacyfolia.world.Dimensions.netherEnabled(GlobalConfiguration.get().misc.enableNether);
     }
 
     @Override
