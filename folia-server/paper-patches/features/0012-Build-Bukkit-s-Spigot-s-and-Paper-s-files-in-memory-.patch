+    // LegacyFolia start - the world's paper-world.yml and the defaults are built in memory from the TOML files, and never saved
+    private W createWorldConfigInMemory(final ContextMap contextMap, final CheckedFunction<ConfigurationNode, W, SerializationException> creator) throws IOException {
+        final @Nullable ConfigurationNode builtDefaults = this.worldDefaultsNode;
+        if (builtDefaults == null) {
+            throw new IllegalStateException("The world defaults configuration has not been initialized");
+        }
+        final Path defaultsConfigFile = this.globalFolder.resolve(this.defaultWorldConfigFileName);
+        final YamlConfigurationLoader defaultsLoader = this.createDefaultWorldLoader(false, this.createDefaultContextMap(contextMap.require(REGISTRY_ACCESS)).build(), defaultsConfigFile).loader();
+        final ConfigurationNode defaultsNode = defaultsLoader.createNode().from(builtDefaults);
+
+        final YamlConfigurationLoader worldLoader = this.createWorldConfigLoaderBuilder(contextMap)
+            .defaultOptions(this.applyObjectMapperFactory(this.createWorldObjectMapperFactoryBuilder(contextMap).build()))
+            .path(contextMap.require(WORLD_DIRECTORY).resolve(this.worldConfigFileName))
+            .build();
+        final @Nullable String worldName = contextMap.get(WORLD_NAME);
+        final ConfigurationNode worldNode = worldLoader.createNode();
+        if (worldName != null) {
+            worldNode.from(io.github.adrielorihuela.legacyfolia.config.ConfigHooks.paperWorld(worldName));
+        } else {
+            worldNode.node(Configuration.VERSION_FIELD).set(this.worldConfigVersion());
+        }
+        this.verifyWorldConfigVersion(contextMap, worldNode);
+        this.applyWorldConfigTransformations(contextMap, worldNode, defaultsNode);
+        this.applyDefaultsAwareWorldConfigTransformations(contextMap, worldNode, defaultsNode);
+        worldNode.mergeFrom(defaultsNode);
+        return creator.apply(worldNode);
+    }
+    // LegacyFolia end - the world's paper-world.yml and the defaults are built in memory from the TOML files, and never saved
+
     protected void verifyWorldConfigVersion(final ContextMap contextMap, final ConfigurationNode worldNode) {
