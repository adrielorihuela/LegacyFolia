From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AdrielOrihuela <adriel.orihuela.m@gmail.com>
Date: Thu, 27 Aug 2026 16:42:57 -0500
Subject: [PATCH] Keep server.properties and the Bukkit files with the
 configuration

They are configuration, so they belong in config/ with the rest of it,
and moving them is what leaves the root of a server directory holding the
jar and nothing else.

An existing file in the root is moved on the first start rather than
abandoned, so an upgrade keeps its port, its MOTD and its aliases. The
--config, --bukkit-settings, --commands-settings and --spigot-settings
arguments still override this outright.

Worth knowing before upgrading: a hosting panel that edits
server.properties by fixed path will not find it any more. The file is
the same, in a different place.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>

diff --git a/src/main/java/org/bukkit/craftbukkit/Main.java b/src/main/java/org/bukkit/craftbukkit/Main.java
index eb0ac87536692ea1215bdbb4646cfa6589e6fb10..3f5ede20bce2a0cd90100c5088d388165de1a098 100644
--- a/src/main/java/org/bukkit/craftbukkit/Main.java
+++ b/src/main/java/org/bukkit/craftbukkit/Main.java
@@ -35,7 +35,10 @@ public class Main {
                 this.acceptsAll(asList("c", "config"), "Properties file to use")
                         .withRequiredArg()
                         .ofType(File.class)
-                        .defaultsTo(new File("server.properties"))
+                        // LegacyFolia - server.properties is configuration and lives with the rest
+                        // of it. An existing one in the root is moved on the first start rather than
+                        // left behind, and --config still overrides this outright.
+                        .defaultsTo(io.github.adrielorihuela.legacyfolia.config.ConfigPaths.resolve("server.properties"))
                         .describedAs("Properties file");
 
                 this.acceptsAll(asList("P", "plugins"), "Plugin directory to use")
@@ -87,13 +90,13 @@ public class Main {
                 this.acceptsAll(asList("b", "bukkit-settings"), "File for bukkit settings")
                         .withRequiredArg()
                         .ofType(File.class)
-                        .defaultsTo(new File("bukkit.yml"))
+                        .defaultsTo(io.github.adrielorihuela.legacyfolia.config.ConfigPaths.resolve("bukkit.yml")) // LegacyFolia - with the rest of the configuration
                         .describedAs("Yml file");
 
                 this.acceptsAll(asList("C", "commands-settings"), "File for command settings")
                         .withRequiredArg()
                         .ofType(File.class)
-                        .defaultsTo(new File("commands.yml"))
+                        .defaultsTo(io.github.adrielorihuela.legacyfolia.config.ConfigPaths.resolve("commands.yml")) // LegacyFolia - with the rest of the configuration
                         .describedAs("Yml file");
 
                 this.accepts("forceUpgrade", "Whether to force a world upgrade");
@@ -117,7 +120,7 @@ public class Main {
                 this.acceptsAll(asList("S", "spigot-settings"), "File for spigot settings")
                         .withRequiredArg()
                         .ofType(File.class)
-                        .defaultsTo(new File("spigot.yml"))
+                        .defaultsTo(io.github.adrielorihuela.legacyfolia.config.ConfigPaths.resolve("spigot.yml")) // LegacyFolia - with the rest of the configuration
                         .describedAs("Yml file");
 
                 this.acceptsAll(asList("paper-dir", "paper-settings-directory"), "Directory for Paper settings")
