From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AdrielOrihuela <adriel.orihuela.m@gmail.com>
Date: Sat, 31 Oct 2026 10:16:51 -0500
Subject: [PATCH] Wear helmets, charge exhaustion and scale by difficulty as
 1.8 did


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 68bd2a5449c8e3752174297022e2fb3dfa67645d..a441a2496b5a396a621d38b6147757057d164c01 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -2583,7 +2583,8 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             }
 
             // Apply damage to helmet
-            if (source.is(DamageTypeTags.DAMAGES_HELMET) && !this.getItemBySlot(EquipmentSlot.HEAD).isEmpty()) {
+            if (source.is(DamageTypeTags.DAMAGES_HELMET) && !this.getItemBySlot(EquipmentSlot.HEAD).isEmpty()
+                && !io.github.adrielorihuela.legacyfolia.combat.Combat.wearHelmet(this, originalDamage + (float)event.getDamage(DamageModifier.INVULNERABILITY_REDUCTION))) { // LegacyFolia - 1.8's helmet wear
                 float helmetDamage = originalDamage;
                 helmetDamage += (float)event.getDamage(DamageModifier.INVULNERABILITY_REDUCTION);
                 helmetDamage += (float)event.getDamage(DamageModifier.BLOCKING);
@@ -2623,7 +2624,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             if (dmg > 0.0F || !human) {
                 if (human) {
                     // PAIL: Be sure to drag all this code from the Player subclass each update.
-                    ((net.minecraft.world.entity.player.Player)this).causeFoodExhaustion(source.getFoodExhaustion(), org.bukkit.event.entity.EntityExhaustionEvent.ExhaustionReason.DAMAGED); // CraftBukkit - EntityExhaustionEvent
+                    ((net.minecraft.world.entity.player.Player)this).causeFoodExhaustion(io.github.adrielorihuela.legacyfolia.combat.Combat.damageExhaustion(source), org.bukkit.event.entity.EntityExhaustionEvent.ExhaustionReason.DAMAGED); // CraftBukkit - EntityExhaustionEvent // LegacyFolia - 1.8's cost of being hurt
                     if (dmg < 3.4028235E37F) {
                         ((net.minecraft.world.entity.player.Player)this).awardStat(Stats.DAMAGE_TAKEN, Math.round(dmg * 10.0F));
                     }
diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index 9c93ab177a377888451424f8491bd3dcbf33b2bf..472f01116d447cdf651bf1bb7a0270f4ed81caaa 100644
--- a/net/minecraft/world/entity/player/Player.java
+++ b/net/minecraft/world/entity/player/Player.java
@@ -722,13 +722,13 @@ public abstract class Player extends Avatar implements ContainerUser {
         }
 
         // this.removeEntitiesOnShoulder(); // CraftBukkit - moved down
-        if (source.scalesWithDifficulty()) {
+        if (io.github.adrielorihuela.legacyfolia.combat.Combat.scalesWithDifficulty(source)) { // LegacyFolia - 1.8 judged this by the direct attacker
             if (level.getDifficulty() == Difficulty.PEACEFUL) {
                 return false; // CraftBukkit - damage = 0.0F -> return false
             }
 
             if (level.getDifficulty() == Difficulty.EASY) {
-                damage = Math.min(damage / 2.0F + 1.0F, damage);
+                damage = io.github.adrielorihuela.legacyfolia.combat.Combat.easyDamage(damage); // LegacyFolia - 1.8 raised a small hit to f / 2 + 1
             }
 
             if (level.getDifficulty() == Difficulty.HARD) {
