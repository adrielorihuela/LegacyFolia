         org.spigotmc.SpigotConfig.registerCommands();
         // Spigot end
         // Paper start - initialize global and world-defaults configuration
diff --git a/net/minecraft/server/dedicated/DedicatedServerSettings.java b/net/minecraft/server/dedicated/DedicatedServerSettings.java
index 842b81a94c538b30c42d1eb101919669f17fe989..2bca7282db1e5edfb9b4e665e3a25ba7a689fc8a 100644
--- a/net/minecraft/server/dedicated/DedicatedServerSettings.java
+++ b/net/minecraft/server/dedicated/DedicatedServerSettings.java
@@ -10,7 +10,7 @@ public class DedicatedServerSettings {
     // CraftBukkit start
     public DedicatedServerSettings(joptsimple.OptionSet options) {
         this.source = ((java.io.File) options.valueOf("config")).toPath();
-        this.properties = DedicatedServerProperties.fromFile(this.source, options);
+        this.properties = new DedicatedServerProperties(io.github.adrielorihuela.legacyfolia.config.ConfigHooks.serverProperties(), options); // LegacyFolia - built from the TOML files and the server.properties mode, never read from the file
         // CraftBukkit end
     }
 
@@ -18,12 +18,14 @@ public class DedicatedServerSettings {
         return this.properties;
     }
 
+    // LegacyFolia start - server.properties belongs to the server.properties mode now; a change
+    // made while running is saved where it lives by Settings.MutableValue#update
     public void forceSave() {
-        this.properties.store(this.source);
     }
 
     public DedicatedServerSettings update(final UnaryOperator<DedicatedServerProperties> mutator) {
-        (this.properties = mutator.apply(this.properties)).store(this.source);
+        this.properties = mutator.apply(this.properties);
         return this;
     }
+    // LegacyFolia end
 }
