             public Identifier getNoItemIcon() {
                 return InventoryMenu.EMPTY_ARMOR_SLOT_SHIELD;
             }
+
+            // LegacyFolia start - 1.8 had no off-hand: nothing goes into the slot by click, drag or shift-click
+            @Override
+            public boolean mayPlace(final ItemStack itemStack) {
+                return !io.github.adrielorihuela.legacyfolia.combat.Combat.offhandDisabled() && super.mayPlace(itemStack);
+            }
