From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AdrielOrihuela <adriel.orihuela.m@gmail.com>
Date: Sat, 31 Oct 2026 10:47:03 -0500
Subject: [PATCH] Explode the way 1.8 did


diff --git a/net/minecraft/world/level/ExplosionDamageCalculator.java b/net/minecraft/world/level/ExplosionDamageCalculator.java
index fc9f57a850923ce9d0f0dbd1f7e5ad376a89bfca..289c980b89a5d144f6cf0bdb7d8432bd89ae599b 100644
--- a/net/minecraft/world/level/ExplosionDamageCalculator.java
+++ b/net/minecraft/world/level/ExplosionDamageCalculator.java
@@ -33,6 +33,7 @@ public class ExplosionDamageCalculator {
         Vec3 center = explosion.center();
         double dist = Math.sqrt(entity.distanceToSqr(center)) / doubleRadius;
         double pow = (1.0 - dist) * exposure;
+        if (io.github.adrielorihuela.legacyfolia.combat.Combat.legacyExplosions()) return io.github.adrielorihuela.legacyfolia.combat.LegacyCombat.explosionDamage(pow, doubleRadius); // LegacyFolia - 1.8's explosion damage
         return (float)((pow * pow + pow) / 2.0 * 7.0 * doubleRadius + 1.0);
     }
 }
diff --git a/net/minecraft/world/level/ServerExplosion.java b/net/minecraft/world/level/ServerExplosion.java
index 79eb05b5f7ac2388eaa41c31239cf4594ce37b53..be83aa022ddd219923550932fabdbdec03552693 100644
--- a/net/minecraft/world/level/ServerExplosion.java
+++ b/net/minecraft/world/level/ServerExplosion.java
@@ -327,6 +327,7 @@ public class ServerExplosion implements Explosion {
     }
 
     public static float getSeenPercent(final Vec3 center, final Entity entity) {
+        if (io.github.adrielorihuela.legacyfolia.combat.Combat.legacyExplosions()) return io.github.adrielorihuela.legacyfolia.combat.Combat.explosionExposure(center, entity); // LegacyFolia - 1.8 stepped through the box in float
         AABB bb = entity.getBoundingBox();
         double xs = 1.0 / ((bb.maxX - bb.minX) * 2.0 + 1.0);
         double ys = 1.0 / ((bb.maxY - bb.minY) * 2.0 + 1.0);
@@ -484,7 +485,8 @@ public class ServerExplosion implements Explosion {
                 if (!entity.ignoreExplosion(this)) {
                     double dist = Math.sqrt(entity.distanceToSqr(this.center)) / doubleRadius;
                     if (!(dist > 1.0)) {
-                        Vec3 entityOrigin = entity instanceof PrimedTnt ? entity.position() : entity.getEyePosition();
+                        Vec3 entityOrigin = entity instanceof PrimedTnt ? (io.github.adrielorihuela.legacyfolia.combat.Combat.legacyExplosions() ? entity.position().add(0.0, entity.getBbHeight() * 0.85F, 0.0) : entity.position()) : entity.getEyePosition(); // LegacyFolia - 1.8 pushed TNT from its head height too
+                        boolean legacyHurt = true; // LegacyFolia - 1.8 pushed only what the explosion hurt
                         Vec3 direction = entityOrigin.subtract(this.center).normalize();
                         boolean shouldDamageEntity = this.damageCalculator.shouldDamageEntity(this, entity);
                         float knockbackMultiplier = this.damageCalculator.getKnockbackMultiplier(entity);
@@ -512,16 +514,23 @@ public class ServerExplosion implements Explosion {
                                     }
                                 }
                             } else {
-                                entity.hurtServer(this.level, this.damageSource, this.damageCalculator.getEntityDamageAmount(this, entity, exposure));
+                                // LegacyFolia start - 1.8 pushed only what the explosion hurt, or what was still invulnerable from a stronger hit
+                                final float legacyAmount = this.damageCalculator.getEntityDamageAmount(this, entity, exposure);
+                                final boolean legacyCooldown = io.github.adrielorihuela.legacyfolia.combat.Combat.explosionHitsCooldown(entity, legacyAmount);
+                                legacyHurt = entity.hurtServer(this.level, this.damageSource, legacyAmount) || legacyCooldown;
+                                // LegacyFolia end - 1.8 pushed only what the explosion hurt
                             }
 
                             if (entity.lastDamageCancelled) { // SPIGOT-5339, SPIGOT-6252, SPIGOT-6777: Skip entity if damage event was cancelled
                                 continue;
                             }
                             // CraftBukkit end
+                            if (!legacyHurt && io.github.adrielorihuela.legacyfolia.combat.Combat.legacyExplosions() && !(entity instanceof PrimedTnt) && !(entity instanceof net.minecraft.world.entity.item.FallingBlockEntity)) { // LegacyFolia - 1.8 pushed only what the explosion hurt
+                                continue;
+                            }
                         }
 
-                        double knockbackResistance = entity instanceof LivingEntity livingEntity
+                        double knockbackResistance = entity instanceof LivingEntity livingEntity && !io.github.adrielorihuela.legacyfolia.combat.Combat.legacyExplosions() // LegacyFolia - 1.8's Blast Protection never reduced the push
                             ? livingEntity.getAttributeValue(Attributes.EXPLOSION_KNOCKBACK_RESISTANCE)
                             : 0.0;
                         double knockbackPower = entity instanceof Player && this.level.paperConfig().environment.disableExplosionKnockback ? 0 : (1.0 - dist) * exposure * knockbackMultiplier * (1.0 - knockbackResistance); // Paper
@@ -537,7 +546,7 @@ public class ServerExplosion implements Explosion {
                         entity.pushFromExplosion(knockback);
                         if (entity.is(EntityTypeTags.REDIRECTABLE_PROJECTILE) && entity instanceof Projectile projectile) {
                             projectile.setOwner(this.damageSource.getEntity());
-                        } else if (entity instanceof Player player && !player.isSpectator() && (!player.isCreative() || !player.getAbilities().flying) && !level.paperConfig().environment.disableExplosionKnockback) { // Paper - Option to disable explosion knockback
+                        } else if (entity instanceof Player player && !player.isSpectator() && (io.github.adrielorihuela.legacyfolia.combat.Combat.legacyExplosions() ? !player.getAbilities().invulnerable : (!player.isCreative() || !player.getAbilities().flying)) && !level.paperConfig().environment.disableExplosionKnockback) { // Paper - Option to disable explosion knockback // LegacyFolia - 1.8 sent no push to an invulnerable player
                             this.hitPlayers.put(player, knockback);
                         }
 
