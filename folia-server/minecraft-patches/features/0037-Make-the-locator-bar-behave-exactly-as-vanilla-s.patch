         super.tick();
+        if (this.level() instanceof ServerLevel serverLevel) serverLevel.getWaypointManager().tick(this); // LegacyFolia - regionised locator bar
         this.updatingUsingItem();
         this.updateSwimAmount();
         if (!this.level().isClientSide()) {
