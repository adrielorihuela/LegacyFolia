                         }
@@ -1112,6 +1125,18 @@ public abstract class Player extends Avatar implements ContainerUser {
     }
 
     private boolean canCriticalAttack(final Entity entity) {
+        // LegacyFolia start - 1.8 allowed a sprinting critical
+        // The last condition below is not in 1.8. Sprinting there did not stop a hit critting,
+        // which is what makes the sprint-jump critical of that version work at all.
+        final io.github.adrielorihuela.legacyfolia.combat.CombatConfig legacyCombat =
+            io.github.adrielorihuela.legacyfolia.combat.Combat.config();
+        if (legacyCombat.enabled() && legacyCombat.legacyCriticals()) {
+            return io.github.adrielorihuela.legacyfolia.combat.LegacyCombat.isCritical(
+                this.fallDistance > 0.0, this.onGround(), this.onClimbable(), this.isInWater(),
+                this.isMobilityRestricted(), this.isPassenger())
+                && entity instanceof LivingEntity;
+        }
+        // LegacyFolia end - 1.8 allowed a sprinting critical
         return this.fallDistance > 0.0
             && !this.onGround()
             && !this.onClimbable()
