From: AdrielOrihuela <adriel.orihuela.m@gmail.com>
Date: Sat, 31 Oct 2026 10:29:55 -0500
Subject: [PATCH] Give a hit 1.8's sounds, statistics, tilt and critical checks


diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index fc8e4da61efe5139b9646748768748e8134fcac4..740a0103f57fcb8b01ed0f45d22da65e885e5668 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -884,6 +884,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
 
     @Override
     public void tick() {
+        io.github.adrielorihuela.legacyfolia.combat.Combat.syncAttackSpeed(this); // LegacyFolia - no charge indicator with no attack cooldown
         // CraftBukkit start
         if (this.joining) {
             this.joining = false;
@@ -3377,7 +3378,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
 
     @Override
     public void indicateDamage(final double xd, final double zd) {
-        this.hurtDir = (float)(Mth.atan2(zd, xd) * 180.0F / (float)Math.PI - this.getYRot());
+        this.hurtDir = io.github.adrielorihuela.legacyfolia.combat.Combat.hurtDirection((float)(Mth.atan2(zd, xd) * 180.0F / (float)Math.PI - this.getYRot())); // LegacyFolia - 1.8 always tilted the same way
         this.connection.send(new ClientboundHurtAnimationPacket(this));
     }
 
diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index eff0346ad0faa433ef5f8677f49de4f8d4fe8586..65ce31906d9bd36ee9e86afa6e86e93c5eb5e042 100644
--- a/net/minecraft/world/entity/player/Player.java
