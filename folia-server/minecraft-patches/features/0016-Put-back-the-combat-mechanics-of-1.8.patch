From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AdrielOrihuela <adriel.orihuela.m@gmail.com>
Date: Sat, 22 Aug 2026 22:35:51 -0500
Subject: [PATCH] Put back the combat mechanics of 1.8

Three hooks, all of them switchable and all off unless [combat] asks for
them.

getAttackStrengthScale answering 1 removes the attack cooldown everywhere
at once: the damage scaling, the charge indicator the client draws, and
the sweep test that depends on a full-strength hit. isSweepAttack
answering false removes the sweeping arc.

The knockback hook is the one that matters most. Modern knockback only
touches the vertical velocity of a target standing on the ground, so
hitting somebody already airborne does not lift them; 1.8 lifted them
every time, and that is what lets a combo hold somebody up.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>

diff --git a/net/minecraft/server/Main.java b/net/minecraft/server/Main.java
index b9998e62dc553284f092c972fb9450b6684fb1d2..76a383048d87989300856eba062dd74b182a3888 100644
--- a/net/minecraft/server/Main.java
+++ b/net/minecraft/server/Main.java
@@ -136,6 +136,7 @@ public class Main {
             // into it on first use need to know whether this run is the one that created it.
             io.github.adrielorihuela.legacyfolia.config.ServerConfig.load();
             io.github.adrielorihuela.legacyfolia.chunks.AdaptiveDistance.reload();
+            io.github.adrielorihuela.legacyfolia.combat.Combat.reload();
             // LegacyFolia end - unified configuration
             Path eulaFile = Paths.get("eula.txt");
             Eula eula = new Eula(eulaFile);
diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index a66f01754046bd9e3946552cac794b2f624214f9..b416aaca3c35a9b482d4ad9057f83a2e5d034ec2 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -2099,11 +2099,20 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             }
 
             Vec3 deltaVector = new Vec3(xd, 0.0, zd).normalize().scale(power);
-            Vec3 targetMovement = new Vec3( // Paper - knockback events
+            // LegacyFolia start - 1.8 knockback
+            // The vertical component below is only applied to a target that is on the ground. In
+            // 1.8 it was applied always, which is what lets a combo hold somebody in the air, so
+            // the whole vector is handed to the legacy formula when that is turned on.
+            final io.github.adrielorihuela.legacyfolia.combat.CombatConfig legacyCombat =
+                io.github.adrielorihuela.legacyfolia.combat.Combat.config();
+            Vec3 targetMovement = legacyCombat.enabled() && legacyCombat.legacyKnockback()
+                ? io.github.adrielorihuela.legacyfolia.combat.LegacyCombat.knockback(deltaMovement, xd, zd, legacyCombat)
+                : new Vec3( // Paper - knockback events
                 deltaMovement.x / 2.0 - deltaVector.x,
                 this.onGround() ? Math.min(0.4, deltaMovement.y / 2.0 + power) : deltaMovement.y,
                 deltaMovement.z / 2.0 - deltaVector.z
             );
+            // LegacyFolia end - 1.8 knockback
             // Paper start - knockback events
             Vec3 knockback = targetMovement.subtract(deltaMovement);
             io.papermc.paper.event.entity.EntityKnockbackEvent event = CraftEventFactory.callEntityKnockbackEvent(this.getBukkitEntity(), attacker, attacker, eventCause, power, knockback);
diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index 978d6f657f4ff84b773e5c320b3e08fce5ba168e..9865433937c4569d1035dae469c39a328f5f4d3a 100644
--- a/net/minecraft/world/entity/player/Player.java
+++ b/net/minecraft/world/entity/player/Player.java
@@ -1123,6 +1123,13 @@ public abstract class Player extends Avatar implements ContainerUser {
     }
 
     private boolean isSweepAttack(final boolean fullStrengthAttack, final boolean criticalAttack, final boolean knockbackAttack) {
+        // LegacyFolia start - 1.8 had no sweeping arc
+        final io.github.adrielorihuela.legacyfolia.combat.CombatConfig legacyCombat =
+            io.github.adrielorihuela.legacyfolia.combat.Combat.config();
+        if (legacyCombat.enabled() && legacyCombat.noSweepAttack()) {
+            return false;
+        }
+        // LegacyFolia end - 1.8 had no sweeping arc
         if (fullStrengthAttack && !criticalAttack && !knockbackAttack && this.onGround()) {
             double approximateSpeedSq = this.getKnownMovement().horizontalDistanceSqr();
             double maxSpeedForSweepAttack = this.getSpeed() * 2.5;
@@ -1965,6 +1972,15 @@ public abstract class Player extends Avatar implements ContainerUser {
     }
 
     public float getAttackStrengthScale(final float a) {
+        // LegacyFolia start - 1.8 had no attack cooldown
+        // Answering 1 here removes it everywhere at once: the damage scaling, the charge indicator
+        // the client draws, and the sweep test that depends on a full-strength hit.
+        final io.github.adrielorihuela.legacyfolia.combat.CombatConfig legacyCombat =
+            io.github.adrielorihuela.legacyfolia.combat.Combat.config();
+        if (legacyCombat.enabled() && legacyCombat.noAttackCooldown()) {
+            return 1.0F;
+        }
+        // LegacyFolia end - 1.8 had no attack cooldown
         return Mth.clamp((this.attackStrengthTicker + a) / this.getCurrentItemAttackStrengthDelay(), 0.0F, 1.0F);
     }
 
