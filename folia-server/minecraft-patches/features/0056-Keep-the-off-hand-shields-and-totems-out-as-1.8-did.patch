diff --git a/net/minecraft/world/inventory/InventoryMenu.java b/net/minecraft/world/inventory/InventoryMenu.java
index 911db526328da69363c36a1ddec51f08f8600138..79fc6a7a38290b3fba360a29f1ee7d95c26a0449 100644
--- a/net/minecraft/world/inventory/InventoryMenu.java
+++ b/net/minecraft/world/inventory/InventoryMenu.java
@@ -75,6 +75,13 @@ public class InventoryMenu extends AbstractCraftingMenu {
             public Identifier getNoItemIcon() {
                 return InventoryMenu.EMPTY_ARMOR_SLOT_SHIELD;
             }
+
+            // LegacyFolia start - 1.8 had no off-hand: nothing goes into the slot by click, drag or shift-click
+            @Override
+            public boolean mayPlace(final ItemStack itemStack) {
+                return !io.github.adrielorihuela.legacyfolia.combat.Combat.offhandDisabled() && super.mayPlace(itemStack);
+            }
+            // LegacyFolia end - 1.8 had no off-hand
         });
     }
 
