From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AdrielOrihuela <adriel.orihuela.m@gmail.com>
Date: Sat, 31 Oct 2026 10:08:53 -0500
Subject: [PATCH] Block with a sword inside the damage modifiers, as 1.8 did


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 3dff6dbc25fbf4cf2749f1b291217dc0770a1bd4..990def5c983e04723d8d0d2b2864e0b78cdd19f4 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -1495,13 +1495,13 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             damage = Float.MAX_VALUE;
         }
 
-        // LegacyFolia start - a raised sword takes (1 + damage) * 0.5, as in 1.8
-        // Applied here rather than through the BLOCKS_ATTACKS component, because swords do not
-        // carry one and giving them a synthetic one would change what every other part of the
-        // game believes a sword is. This sits before the armour step because 1.8 ran blocking
-        // first, so the two compound.
-        damage = io.github.adrielorihuela.legacyfolia.combat.Combat.afterBlocking(this, damage);
-        // LegacyFolia end - a raised sword takes (1 + damage) * 0.5
+        // LegacyFolia start - 1.8's damage window
+        // 1.8 compared the raw damage with the last hit's, handed only the difference to the damage
+        // modifiers (hard hat, a raised sword, armour...) and remembered the raw figure, not what
+        // was left of it.
+        final boolean legacyDamageWindow = io.github.adrielorihuela.legacyfolia.combat.Combat.legacyDamageWindow();
+        final float legacyRawDamage = damage;
+        // LegacyFolia end - 1.8's damage window
 
         EntityDamageEvent event; // CraftBukkit // Paper - move this into the actual invuln check....
         boolean tookFullDamage = true;
@@ -1511,6 +1511,15 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             }
 
             // Paper start - only call damage event when actuallyHurt will be called - move call logic down
+            // LegacyFolia start - 1.8's damage window: the difference is the event's base
+            if (legacyDamageWindow) {
+                final float legacyThrough = io.github.adrielorihuela.legacyfolia.combat.Combat.damageThroughWindow(damage, this.lastHurt);
+                if (legacyThrough <= 0.0F) {
+                    return false;
+                }
+                event = this.handleEntityDamage(source, legacyThrough, 0);
+            } else
+            // LegacyFolia end - 1.8's damage window
             event = this.handleEntityDamage(source, damage, this.lastHurt); // Paper - fix invulnerability reduction in EntityDamageEvent - pass lastDamage reduction
             damage = this.computeAmountFromEntityDamageEvent(event);
             // Paper end - only call damage event when actuallyHurt will be called - move call logic down
@@ -1521,7 +1530,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             }
             if (this instanceof ServerPlayer && event.getDamage() == 0 && originalDamage == 0) return false; // Paper - revert to vanilla damage - players are not affected by damage that is 0 - skip damage if the vanilla damage is 0 and was not modified by plugins in the event.
             // CraftBukkit end
-            this.lastHurt = damage;
+            this.lastHurt = legacyDamageWindow ? legacyRawDamage : damage; // LegacyFolia - 1.8 remembered the raw damage
             tookFullDamage = false;
         } else {
             // Paper start - only call damage event when actuallyHurt will be called - move call logic down
@@ -1533,7 +1542,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                 return false;
             }
             if (this instanceof ServerPlayer && event.getDamage() == 0 && originalDamage == 0) return false; // Paper - revert to vanilla damage - players are not affected by damage that is 0 - skip damage if the vanilla damage is 0 and was not modified by plugins in the event.
-            this.lastHurt = damage;
+            this.lastHurt = legacyDamageWindow ? legacyRawDamage : damage; // LegacyFolia - 1.8 remembered the raw damage
             this.damageCooldownTime = this.invulnerableDuration; // CraftBukkit - restore use of maxNoDamageTicks
             // this.actuallyHurt(level, source, damage);
             // CraftBukkit end
@@ -2505,6 +2514,15 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         damage += hardHatModifier;
 
         com.google.common.base.Function<Double, Double> blocking = mod -> {
+            // LegacyFolia start - a raised sword takes (1 + damage) * 0.5, as in 1.8
+            // A modifier like the shield's, after the window and the hard hat and before armour,
+            // which is where 1.8 had it. Swords carry no BLOCKS_ATTACKS, so none of the shield's
+            // side effects follow from it.
+            final Double legacySwordBlocking = io.github.adrielorihuela.legacyfolia.combat.Combat.swordBlocking(LivingEntity.this, damagesource, mod);
+            if (legacySwordBlocking != null) {
+                return legacySwordBlocking;
+            }
+            // LegacyFolia end - a raised sword takes (1 + damage) * 0.5
             if (!LivingEntity.this.canBlockAttack(damagesource, mod.floatValue())) {
                 return 0D;
             }
