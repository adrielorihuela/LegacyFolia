+                if (io.github.adrielorihuela.legacyfolia.combat.Combat.legacyReach() ? io.github.adrielorihuela.legacyfolia.combat.Combat.withinReach(this.player, target) : this.player.isWithinEntityInteractionRange(targetBounds, io.papermc.paper.configuration.GlobalConfiguration.get().misc.clientInteractionLeniencyDistance.or(3.0))) { // Paper - configurable lenience value for interact range // LegacyFolia - 1.8's reach check
                     InteractionHand hand = packet.hand();
