From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AdrielOrihuela <adriel.orihuela.m@gmail.com>
Date: Sat, 31 Oct 2026 11:06:09 -0500
Subject: [PATCH] Fall, burn and prick the way 1.8 did


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index f8b3c6a11b42225f391b69ba32b363709e77abac..4ecf40891a090b5d70c6aaeb7c6867b715ab333b 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -2379,6 +2379,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             return 0;
         }
 
+        if (io.github.adrielorihuela.legacyfolia.combat.Combat.config().enabled()) return io.github.adrielorihuela.legacyfolia.combat.LegacyCombat.fallDamage(fallDistance, this.getAttributeValue(Attributes.SAFE_FALL_DISTANCE), damageModifier, this.getAttributeValue(Attributes.FALL_DAMAGE_MULTIPLIER)); // LegacyFolia - 1.8 rounded a fall up
         double baseDamage = this.calculateFallPower(fallDistance);
         return Mth.floor(baseDamage * damageModifier * this.getAttributeValue(Attributes.FALL_DAMAGE_MULTIPLIER));
     }
@@ -5040,6 +5041,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
 
     @Override
     public void igniteForTicks(final int numberOfTicks) {
+        if (io.github.adrielorihuela.legacyfolia.combat.Combat.config().enabled()) { super.igniteForTicks(io.github.adrielorihuela.legacyfolia.combat.Combat.burnTicks(this, numberOfTicks)); return; } // LegacyFolia - 1.8's Fire Protection
         super.igniteForTicks(Mth.ceil(numberOfTicks * this.getAttributeValue(Attributes.BURNING_TIME)));
     }
 
diff --git a/net/minecraft/world/entity/animal/golem/IronGolem.java b/net/minecraft/world/entity/animal/golem/IronGolem.java
index d517d59dc3e05be34dbeebb640a038dc13f4dfb6..74d8d87ca0d89863be7da67fb28426bf032db724 100644
--- a/net/minecraft/world/entity/animal/golem/IronGolem.java
+++ b/net/minecraft/world/entity/animal/golem/IronGolem.java
@@ -193,6 +193,7 @@ public class IronGolem extends AbstractGolem implements NeutralMob {
         if (hurt) {
             double knockbackResistance = target instanceof LivingEntity livingEntity ? livingEntity.getAttributeValue(Attributes.KNOCKBACK_RESISTANCE) : 0.0;
             double scale = Math.max(0.0, 1.0 - knockbackResistance);
+            if (io.github.adrielorihuela.legacyfolia.combat.Combat.legacyKnockback()) scale = 1.0; // LegacyFolia - 1.8's golem threw whatever it hit
             target.setDeltaMovement(target.getDeltaMovement().add(0.0, 0.4F * scale, 0.0));
             EnchantmentHelper.doPostAttackEffects(level, target, damageSource);
         }
diff --git a/net/minecraft/world/item/enchantment/EnchantmentHelper.java b/net/minecraft/world/item/enchantment/EnchantmentHelper.java
index 9c667a09fcea23b4072c0616837b685e256e0462..48ba39e392a4a7314054686df48d6c26bdc8a7c0 100644
--- a/net/minecraft/world/item/enchantment/EnchantmentHelper.java
+++ b/net/minecraft/world/item/enchantment/EnchantmentHelper.java
@@ -244,9 +244,13 @@ public class EnchantmentHelper {
         final @Nullable Consumer<ItemStack> attackerlessOnBreak
     ) {
         if (victim instanceof LivingEntity livingVictim) {
+            final boolean legacyThorns = io.github.adrielorihuela.legacyfolia.combat.Combat.config().enabled(); // LegacyFolia - 1.8's thorns
             runIterationOnEquipment(
                 livingVictim,
-                (enchantment, level, item) -> enchantment.value().doPostAttack(serverLevel, level, item, EnchantmentTarget.VICTIM, victim, damageSource)
+                (enchantment, level, item) -> {
+                    if (legacyThorns && enchantment.is(Enchantments.THORNS)) { io.github.adrielorihuela.legacyfolia.combat.Combat.thorns(serverLevel, livingVictim, damageSource, level); return; } // LegacyFolia - 1.8's thorns
+                    enchantment.value().doPostAttack(serverLevel, level, item, EnchantmentTarget.VICTIM, victim, damageSource);
+                }
             );
         }
 
diff --git a/net/minecraft/world/level/block/BaseFireBlock.java b/net/minecraft/world/level/block/BaseFireBlock.java
index 580fac7e521e635fa1177652a2e6a287585589d2..4f5bbeaff9154a9b44b43c5854c94968ed6d550e 100644
--- a/net/minecraft/world/level/block/BaseFireBlock.java
+++ b/net/minecraft/world/level/block/BaseFireBlock.java
@@ -143,7 +143,7 @@ public abstract class BaseFireBlock extends Block {
         if (!entity.fireImmune()) {
             if (entity.getRemainingFireTicks() < 0) {
                 entity.setRemainingFireTicks(entity.getRemainingFireTicks() + 1);
-            } else if (entity instanceof ServerPlayer) {
+            } else if (entity instanceof ServerPlayer && !io.github.adrielorihuela.legacyfolia.combat.Combat.config().enabled()) { // LegacyFolia - 1.8 held a player in fire at eight seconds
                 int addedFireTicks = entity.level().getRandom().nextInt(1, 3);
                 entity.setRemainingFireTicks(entity.getRemainingFireTicks() + addedFireTicks);
             }
diff --git a/net/minecraft/world/level/block/HayBlock.java b/net/minecraft/world/level/block/HayBlock.java
index 07141d81335d8a82f71498f66788d555beb287ae..57c98bf1cea75940c448e7832fcad3fea7c3731a 100644
--- a/net/minecraft/world/level/block/HayBlock.java
+++ b/net/minecraft/world/level/block/HayBlock.java
@@ -15,6 +15,6 @@ public class HayBlock extends RotatedPillarBlock {
 
     @Override
     public void fallOn(final Level level, final BlockState state, final BlockPos pos, final Entity entity, final double fallDistance) {
-        entity.causeFallDamage(fallDistance, 0.2F, level.damageSources().fall());
+        entity.causeFallDamage(fallDistance, io.github.adrielorihuela.legacyfolia.combat.Combat.config().enabled() ? 1.0F : 0.2F, level.damageSources().fall()); // LegacyFolia - 1.8's hay bales broke no fall
     }
 }
