From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AdrielOrihuela <adriel.orihuela.m@gmail.com>
Date: Sat, 22 Aug 2026 21:15:49 -0500
Subject: [PATCH] Hook adaptive view distance into the server

Activity comes from the packets that already carry those actions, placed
after the thread guard so each runs on the player's own thread. The
periodic check hangs off the player's own tick rather than a global
sweep, which spreads the work out and keeps every read where it belongs.

Chat is hooked before its guard on purpose: it is handled on a netty
thread, and the method it calls touches only volatile fields.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>

diff --git a/net/minecraft/server/Main.java b/net/minecraft/server/Main.java
index c3d0787cab8e3cd325398dd353488e188e6c0b5c..13d7c16d9ce9ccd6e496764c7c330d09b0478285 100644
--- a/net/minecraft/server/Main.java
+++ b/net/minecraft/server/Main.java
@@ -135,6 +135,7 @@ public class Main {
             // from Bukkit, Spigot and Paper. Loaded exactly once, because settings that migrate
             // into it on first use need to know whether this run is the one that created it.
             io.github.adrielorihuela.legacyfolia.config.ServerConfig.load();
+            io.github.adrielorihuela.legacyfolia.chunks.AdaptiveDistance.reload();
             // LegacyFolia end - unified configuration
             Path eulaFile = Paths.get("eula.txt");
             Eula eula = new Eula(eulaFile);
diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 6bb34d13d6806f93a67b0d8fc63a272e7b4172d2..38554593bb95c7e9f521416535be14f2a3a74e05 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -979,6 +979,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
     }
 
     public void doTick() {
+        io.github.adrielorihuela.legacyfolia.chunks.AdaptiveDistance.tick(this); // LegacyFolia - adaptive view distance
         try {
             if (this.valid && (!this.isSpectator() || !this.touchingUnloadedChunk())) { // Paper - don't tick dead players that are not in the world currently (pending respawn)
                 super.tick();
@@ -3003,6 +3004,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         this.language = information.language();
         this.adventure$locale = java.util.Objects.requireNonNullElse(net.kyori.adventure.translation.Translator.parseLocale(this.language), java.util.Locale.US); // Paper
         this.requestedViewDistance = information.viewDistance();
+        io.github.adrielorihuela.legacyfolia.chunks.AdaptiveDistance.evaluateNow(this); // LegacyFolia - adaptive view distance, the client just told us what it wants
         this.chatVisibility = information.chatVisibility();
         this.canChatColor = information.chatColors();
         this.textFilteringEnabled = information.textFilteringEnabled();
diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 35c1a7a250ed43c4bc45fc80835974003ce2a8e0..fcf0111f51b16b1645a1c0adb6a9220ec2cefdf1 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -1523,6 +1523,7 @@ public class ServerGamePacketListenerImpl
     @Override
     public void handleMovePlayer(final ServerboundMovePlayerPacket packet) {
         PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
+        io.github.adrielorihuela.legacyfolia.chunks.AdaptiveDistance.onMovement(this.player); // LegacyFolia - adaptive view distance
         if (containsInvalidValues(packet.getX(0.0), packet.getY(0.0), packet.getZ(0.0), packet.getYRot(0.0F), packet.getXRot(0.0F))) {
             this.disconnect(Component.translatable("multiplayer.disconnect.invalid_player_movement"), org.bukkit.event.player.PlayerKickEvent.Cause.INVALID_PLAYER_MOVEMENT); // Paper - kick event cause
         } else {
@@ -2047,6 +2048,7 @@ public class ServerGamePacketListenerImpl
     @Override
     public void handlePlayerAction(final ServerboundPlayerActionPacket packet) {
         PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
+        io.github.adrielorihuela.legacyfolia.chunks.AdaptiveDistance.onDeliberateAction(this.player); // LegacyFolia - adaptive view distance
         if (this.player.isImmobile()) return; // CraftBukkit
         if (this.hasClientLoaded()) {
             BlockPos pos = packet.getPos();
@@ -2296,6 +2298,7 @@ public class ServerGamePacketListenerImpl
     @Override
     public void handleUseItem(final ServerboundUseItemPacket packet) {
         PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
+        io.github.adrielorihuela.legacyfolia.chunks.AdaptiveDistance.onDeliberateAction(this.player); // LegacyFolia - adaptive view distance
         if (this.player.isImmobile()) return; // CraftBukkit
         if (!this.checkLimit(packet.timestamp())) return; // Spigot - check limit
         if (this.hasClientLoaded()) {
@@ -2458,6 +2461,7 @@ public class ServerGamePacketListenerImpl
     public void handleChat(final ServerboundChatPacket packet) {
         // CraftBukkit start - async chat
         // SPIGOT-3638
+        io.github.adrielorihuela.legacyfolia.chunks.AdaptiveDistance.onChat(this.player, packet.message()); // LegacyFolia - adaptive view distance (safe from this thread: volatile fields only)
         if (this.server.isStopped()) {
             return;
         }
@@ -2786,6 +2790,7 @@ public class ServerGamePacketListenerImpl
     @Override
     public void handlePunch(final ServerboundPunchPacket packet) {
         PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
+        io.github.adrielorihuela.legacyfolia.chunks.AdaptiveDistance.onSwing(this.player); // LegacyFolia - adaptive view distance
         if (this.player.isImmobile()) return; // CraftBukkit
         this.player.resetLastActionTime();
         // CraftBukkit start - Raytrace to look for 'rogue armswings'
@@ -3010,6 +3015,7 @@ public class ServerGamePacketListenerImpl
     @Override
     public void handleInteract(final ServerboundInteractPacket packet) {
         PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
+        io.github.adrielorihuela.legacyfolia.chunks.AdaptiveDistance.onDeliberateAction(this.player); // LegacyFolia - adaptive view distance
         if (this.player.isImmobile()) return; // CraftBukkit
         if (this.hasClientLoaded()) {
             ServerLevel level = this.player.level();
@@ -3203,6 +3209,7 @@ public class ServerGamePacketListenerImpl
     @Override
     public void handleContainerClick(final ServerboundContainerClickPacket packet) {
         PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
+        io.github.adrielorihuela.legacyfolia.chunks.AdaptiveDistance.onDeliberateAction(this.player); // LegacyFolia - adaptive view distance
         if (this.player.isImmobile()) return; // CraftBukkit
         this.player.resetLastActionTime();
         if (this.player.containerMenu.containerId == packet.containerId() && this.player.containerMenu.stillValid(this.player)) { // CraftBukkit
diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
